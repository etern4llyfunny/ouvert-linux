pkgname=ouvert-updater
pkgver=1.0
pkgrel=1
pkgdesc="Lightweight update checker and notifier for Ouvert Linux"
arch=('any')
url="https://github.com/etern4llyfunny/ouvert-linux"
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'pacman-contrib' 'polkit' 'libnotify')
source=(
    'ouvert-updater.py'
    'ouvert-updater-notify'
    'ouvert-updater-notify.service'
    'ouvert-updater-notify.timer'
    'ouvert-updater.desktop'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/ouvert-updater.py" "$pkgdir/usr/bin/ouvert-updater"
    install -Dm755 "$srcdir/ouvert-updater-notify" "$pkgdir/usr/lib/ouvert-updater/notify.sh"
    install -Dm644 "$srcdir/ouvert-updater-notify.service" "$pkgdir/usr/lib/systemd/user/ouvert-updater-notify.service"
    install -Dm644 "$srcdir/ouvert-updater-notify.timer" "$pkgdir/usr/lib/systemd/user/ouvert-updater-notify.timer"
    install -dm755 "$pkgdir/usr/lib/systemd/user/timers.target.wants"
    ln -s ../ouvert-updater-notify.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/ouvert-updater-notify.timer"
    install -Dm644 "$srcdir/ouvert-updater.desktop" "$pkgdir/usr/share/applications/ouvert-updater.desktop"
}
